NODE_ENV=development
PORT=3010

# Cloud MySQL — ชุดเดียวกับ posApp (DB_REMOTE_* ของ posApp)
# คัดลอกค่าจริงไปที่ backend/.env.local (ไฟล์นี้เป็น template ที่ commit ได้)
DB_MODE=remote
DB_REMOTE_HOST=
DB_REMOTE_PORT=3306
DB_REMOTE_NAME=
DB_REMOTE_USER=
DB_REMOTE_PASSWORD=

# ต้องคนละค่ากับ JWT_SECRET ของ posApp — token ข้ามแอปใช้ไม่ได้
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
# 0 = ไม่ตัด session เมื่อว่าง (หมดอายุตาม JWT_EXPIRES_IN)
SESSION_IDLE_TIMEOUT_MINUTES=0

# ชื่อบริษัทสำรอง ถ้าอ่านตาราง companies ไม่ได้
COMPANY_NAME=

FRONTEND_URL=http://localhost:5174,https://vendor.znix.online
